# BigTrooper environment
# Copy this file to .env and fill in the values:  cp .env.example .env
# Never commit .env; it holds real secrets. This example file must only ever
# contain placeholders.

# -----------------------------------------------------------------------------
# Database (Postgres, see docker-compose.yml)
# -----------------------------------------------------------------------------
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=bigtrooper
DB_HOST=localhost
DB_PORT=5432
# Used by the API and by db.sh / migrate. Built from the values above.
DATABASE_URL=postgres://root:change-me@localhost:5432/bigtrooper?sslmode=disable

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Where the React app sends API requests.
# WARNING: anything starting with VITE_ is bundled into the browser JavaScript
# and visible to everyone. Never put secrets in a VITE_ variable.
VITE_API_URL=http://localhost:8080/api

# -----------------------------------------------------------------------------
# Pet photos (Cloudflare R2)
# -----------------------------------------------------------------------------
# Leave these empty to run without photo uploads; the API logs that uploads
# are disabled and everything else keeps working.
# Create the keys under R2 > Manage API tokens (Object Read & Write, scoped to
# the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public custom domain, INCLUDING https://. Without the scheme,
# browsers treat it as a path on this site and images break.
R2_PUBLIC_URL=https://images.example.com

# -----------------------------------------------------------------------------
# Security & deployment
# -----------------------------------------------------------------------------
# Only send the login cookie over HTTPS.
#   Local dev: false (localhost is plain HTTP, so true would break login)
#   Production: true
COOKIE_SECURE=false

# Which websites may call the API from a browser, comma-separated, exact
# origins with no trailing slash.
#   Local dev: http://localhost:5173
#   Production: https://bigtrooper.com (add https://www.bigtrooper.com if used)
# If your site's origin is missing, the browser blocks every request.
CORS_ORIGINS=http://localhost:5173

# How the API learns a visitor's real IP address (used for rate limiting).
# Pick ONE of the two below, or leave both empty.
#
# Empty (default, local dev): forwarded headers are ignored and the connecting
# IP is used. Safe, but behind a proxy every visitor looks like the proxy, so
# they'd all share one rate limit.
#
# TRUSTED_PLATFORM=cloudflare
#   Use this when traffic reaches the API through Cloudflare (proxied DNS).
#   The real IP is read from Cloudflare's CF-Connecting-IP header.
TRUSTED_PLATFORM=
#
# TRUSTED_PROXIES=10.0.0.0/8,192.168.1.10
#   Use this behind your own reverse proxy (nginx, Caddy, a load balancer):
#   the IPs/CIDRs of the proxies allowed to set X-Forwarded-For. Never list
#   ranges you don't control, or anyone could fake their IP and dodge rate
#   limits. An invalid value stops the API at startup with an error.
TRUSTED_PROXIES=
